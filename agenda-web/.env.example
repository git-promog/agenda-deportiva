# Configuración pública de Supabase (Lectura en cliente)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Configuración privada de Supabase (Solo servidor)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# Configuración de IA (Gemini)
GEMINI_API_KEY=tu-gemini-api-key-aqui

# Seguridad de Administración y API Secret
ADMIN_PASSWORD=tu-contrasena-admin-segura
ADMIN_API_SECRET=tu-api-secret-super-seguro

# Secreto independiente y obligatorio para firmar las cookies de sesión admin (HMAC).
# Genera uno con: openssl rand -hex 32
ADMIN_SESSION_SECRET=tu-secreto-de-sesion-aleatorio

# Verificación del sitio en Search Console (metatag de Google)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=tu-codigo-de-verificacion
